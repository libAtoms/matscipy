# the blocks are separated by empty lines
# comments are allowed
#
# Charges
C1 -0.010
H1  0.010

# Nonbonded-Interactions
C1-C1 lj/cut 0.001 3.50 cutoff 3.0
C1-H1 lj/cut 0.001 3.00 cutoff 3.0
H1-H1 lj/cut 0.001 2.50 cutoff 3.0

# Weighting
lj/cut lj 0.0 0.0 0.5

# Bonds
C1-C1 harmonic 10.0 1.0
C1-H1 harmonic 10.0 1.0

# Angles
H1-C1-C1 harmonic 1.0 100.0
H1-C1-H1 harmonic 1.0 100.0

# Dihedrals 
H1-C1-C1-H1 opls 0.00 0.00 0.01 0.00

# Cutoffs 
C1-C1 1.85
C1-H1 1.15
H1-H1 0.0
