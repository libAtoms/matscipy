# OPLS potential
# bonds
bond_style      harmonic
bond_coeff      1 10.0 1.0 # C1-H1
bond_coeff      2 10.0 1.0 # C1-C1

# angles
angle_style      harmonic
angle_coeff      1 1.0 100.0 # H1-C1-C1

# dihedrals
dihedral_style      opls
dihedral_coeff      1 0.0 0.0 0.01 0.0 # H1-C1-C1-H1

# L-J parameters
pair_style hybrid lj/cut/coul/long 12.0 15.0 mie/cut 4.0
special_bonds lj/coul 0.0 0.0 0.5
pair_coeff   1   1 lj/cut/coul/long  0.001  3.5 12.0 15.0      # C1-C1
pair_coeff   2   2 lj/cut/coul/long  0.001  2.5 12.0 15.0      # H1-H1
pair_coeff   1   2 mie/cut           0.0025 4.3 16.0  6.0 4.0  # C1-H1
pair_modify shift yes mix geometric

# charges
set type 1 charge -0.01 # C1
set type 2 charge 0.01 # H1
